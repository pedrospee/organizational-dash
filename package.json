{
  "name": "solvia",
  "version": "0.0.0",
  "private": true,
  "description": "Personal financial planning system for EUR and BRL.",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env backend/src/main.ts",
    "start": "node --env-file-if-exists=.env backend/dist/backend/src/main.js",
    "build": "tsc -p backend/tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "secrets:scan": "gitleaks git --redact --verbose .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
