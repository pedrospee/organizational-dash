{
  "name": "solvia",
  "version": "0.0.0",
  "private": true,
  "description": "Personal financial planning system for EUR and BRL.",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@solvia/backend",
    "start": "npm run start --workspace=@solvia/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "secrets:scan": "gitleaks git --redact --verbose .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
